# ============================================================
# ivvibill — contoh berkas .env
# Salin ke .env lalu isi:  cp .env.example .env
# Jangan pernah commit .env yang asli.
# ============================================================

# --- mode & port -------------------------------------------------
NODE_ENV=production
PORT=3010
# 127.0.0.1 = hanya di belakang nginx/reverse proxy (disarankan).
# Ubah 0.0.0.0 HANYA bila tidak ada proxy sama sekali.
BIND=127.0.0.1

# --- database (wajib) --------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=ivvibill_app
DB_PASS=GANTI_PASSWORD_KUAT
DB_NAME=ivvibill
# DB_POOL=10

# --- keamanan (wajib) --------------------------------------------
# Tanda tangan JWT. Buat acak:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
# JWT_TTL=12h
BCRYPT_ROUNDS=12
# MAX_LOGIN_FAIL=5
# LOCK_MINUTES=15

# Kunci enkripsi rahasia gateway/perangkat. Buat dengan:
#   npm run init-secret -- /etc/ivvibill/secret.key
# lalu isi baris berikut (di luar web root = lebih aman):
# APP_SECRET_FILE=/etc/ivvibill/secret.key
# APP_SECRET=

# --- URL publik (wajib) ------------------------------------------
# Dipakai untuk tautan tagihan/WA dan menyalakan cookie Secure.
# Ganti ke https:// setelah SSL terpasang.
BASE_URL=http://domain-anda.com

# --- proxy -------------------------------------------------------
# 1 bila di belakang nginx/OpenLiteSpeed/CDN (disarankan)
TRUST_PROXY=1
# IP yang boleh memanggil /internal/cron/* (pisahkan koma)
TRUSTED_IPS=127.0.0.1,::1

# --- opsional ----------------------------------------------------
# Token cron HTTP luar; bila kosong fallback ke JWT_SECRET
# CRON_TOKEN=
# IP tambahan yang boleh mengirim webhook gateway (bolek pola *.0.0.0)
# WEBHOOK_IPS=
# 1 = matikan scheduler in-process (pakai scripts/cron.js / cron eksternal)
# DISABLE_SCHEDULER=1
# Interval deteksi issue pelanggan PPPoE, menit (default 10)
# ISSUE_INTERVAL_MIN=10
# Lokasi unggahan bukti pembayaran (default storage/uploads)
# UPLOAD_DIR=
# TZ=Asia/Jakarta
